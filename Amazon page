<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Amazon Product Page Clone</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background-color: #f3f3f3;
    }
    .navbar {
      background-color: #131921;
      color: white;
      padding: 15px;
      text-align: center;
      font-size: 20px;
    }
    .container {
      display: flex;
      padding: 20px;
      background-color: white;
      margin: 20px;
      border-radius: 8px;
    }
    .product-img {
      flex: 1;
      text-align: center;
    }
    .product-img img {
      width: 300px;
      border-radius: 8px;
    }
    .product-details {
      flex: 2;
      padding: 20px;
    }
    .product-title {
      font-size: 24px;
      font-weight: bold;
    }
    .rating {
      color: #ffa41c;
      margin: 10px 0;
    }
    .price {
      font-size: 22px;
      color: #B12704;
      margin: 10px 0;
    }
    .btn {
      background-color: #FFD814;
      border: none;
      padding: 12px 20px;
      font-size: 16px;
      cursor: pointer;
      border-radius: 8px;
    }
    .btn:hover {
      background-color: #F7CA00;
    }
  </style>
</head>
<body>
  <div class="navbar">Amazon Clone</div>

  <div class="container">
    <div class="product-img">
      <img src="https://via.placeholder.com/300x400.png?text=Product+Image" alt="Product">
    </div>
    <div class="product-details">
      <div class="product-title">Wireless Bluetooth Headphones</div>
      <div class="rating">⭐⭐⭐⭐☆ (4.2/5)</div>
      <div class="price">₹2,999</div>
      <p>High-quality wireless headphones with noise cancellation, deep bass, and 20 hours of battery life.</p>
      <button class="btn" onclick="addToCart()">Add to Cart</button>
    </div>
  </div>

  <script>
    function addToCart() {
      alert("✅ Item added to cart!");
    }
  </script>
</body>
</html>
